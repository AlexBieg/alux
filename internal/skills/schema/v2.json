{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "alux skill, format v1",
  "type": "object",
  "required": ["schema", "skill", "version", "when", "nodes"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 2 },
    "skill": { "$ref": "#/$defs/name" },
    "version": { "type": "integer", "minimum": 1 },
    "when": { "type": "string", "minLength": 1 },
    "not_for": { "type": "string", "minLength": 1 },
    "starts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["user", "model"] }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": { "$ref": "#/$defs/tools" },
        "optional_tools": { "$ref": "#/$defs/tools" }
      }
    },
    "inputs": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/ident" },
      "additionalProperties": { "$ref": "#/$defs/input" }
    },
    "vars": {
      "type": "object",
      "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]*$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/node" }
    },
    "order": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "items": { "$ref": "#/$defs/name" }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "ident": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "count": {
      "type": ["integer", "string"],
      "minimum": 1,
      "pattern": "^\\$\\{[a-z][a-z0-9_]*\\}$"
    },
    "tools": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "input": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["string", "int", "bool"] },
        "description": { "type": "string" },
        "default": {},
        "enum": { "type": "array", "minItems": 1, "uniqueItems": true }
      }
    },
    "node": {
      "type": "object",
      "minProperties": 1,
      "dependentRequired": { "say": ["evidence"], "evidence": ["say"] },
      "additionalProperties": false,
      "properties": {
        "say": { "type": "string", "minLength": 1 },
        "optional": { "type": "boolean" },
        "strict": { "type": "boolean" },
        "when": { "$ref": "#/$defs/condition" },
        "loop": {
          "type": "object",
          "required": ["times"],
          "additionalProperties": false,
          "properties": { "times": { "$ref": "#/$defs/count" } }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/rule" }
        }
      }
    },
    "condition": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "available": { "type": "string", "minLength": 1 },
        "input": { "$ref": "#/$defs/ident" },
        "out": { "$ref": "#/$defs/ident" },
        "equals": {},
        "in": { "type": "array", "minItems": 1 }
      }
    },
    "rule": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "call": {
          "type": "object",
          "required": ["tool"],
          "additionalProperties": false,
          "properties": {
            "tool": {
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              ]
            },
            "when": { "type": "string", "minLength": 1 },
            "min": { "$ref": "#/$defs/count" },
            "distinct": { "enum": ["query", "url", "domain"] }
          }
        },
        "fetches_opened": {
          "type": "object",
          "required": ["min"],
          "additionalProperties": false,
          "properties": { "min": { "$ref": "#/$defs/count" } }
        },
        "artifact_lines": {
          "type": "object",
          "required": ["path", "pattern"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "pattern": { "type": "string", "minLength": 1 },
            "min": { "$ref": "#/$defs/count" },
            "max": {
              "type": ["integer", "string"],
              "minimum": 0,
              "pattern": "^\\$\\{[a-z][a-z0-9_]*\\}$"
            },
            "section": { "type": "string", "minLength": 1 },
            "covers": {
              "type": "object",
              "required": ["path", "pattern"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "pattern": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "citations_fetched": {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "min": { "$ref": "#/$defs/count" }
          }
        },
        "leads_followed": {
          "type": "object",
          "required": ["path", "min"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "min": { "$ref": "#/$defs/count" },
            "not_in_input": { "$ref": "#/$defs/ident" }
          }
        },
        "subagent_skill": {
          "type": "object",
          "required": ["skill"],
          "additionalProperties": false,
          "properties": {
            "skill": { "$ref": "#/$defs/name" },
            "min": { "$ref": "#/$defs/count" }
          }
        },
        "poll_stopped": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "min": { "$ref": "#/$defs/count" } }
        }
      }
    }
  }
}
